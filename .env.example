# ============================================================================
# MailBlaster AI - configuration template.  Copy to `.env` (git-ignored) and fill in.
# `.env` is read ONLY by the local helper scripts (deploy / build). Production secrets
# are stored as Cloudflare Worker secrets by DEPLOY_WORKER.bat, never committed.
# ============================================================================

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SECRET: service_role key. Only the Cloudflare Worker may use it. Never put it in the dashboard or extension.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, type "Web application") ---
GOOGLE_CLIENT_ID=
# SECRET
GOOGLE_CLIENT_SECRET=
# Must be listed under "Authorized redirect URIs": <API_BASE_URL>/oauth/google/callback
GOOGLE_REDIRECT_URI=

# --- Cloudflare ---
CLOUDFLARE_ACCOUNT_ID=
# Only needed for non-interactive deploys (CI). `npx wrangler login` is enough on your own PC.
# CLOUDFLARE_API_TOKEN=

# --- Public URLs (free *.workers.dev and *.pages.dev subdomains, no domain purchase needed) ---
API_BASE_URL=
FRONTEND_URL=

# --- Encryption of Google refresh tokens at rest (AES-256-GCM). SECRET.
# Generate with:  node scripts/gen-key.mjs      (or: openssl rand -base64 32)
# If you ever change it, connected Gmail accounts must be reconnected.
ENCRYPTION_KEY=

# --- Optional ---
# Close registration after you created your own account (recommended for personal use)
# ALLOW_SIGNUPS=false
# Pin the Chrome extension IDs allowed to call the API
# ALLOWED_EXTENSION_IDS=
# Emails per cron run (1-10). Lower to 1 if the Workers Free CPU limit is hit
# MAX_JOBS_PER_RUN=3
