# Dashboard build-time configuration (Vite). These values are PUBLIC (they end up in the browser bundle).
# Never put secrets here: the Supabase *anon* key is safe because Row Level Security protects the data.
VITE_API_BASE_URL=https://mailblaster-api.YOUR-SUBDOMAIN.workers.dev
# Optional: enables live campaign progress through Supabase Realtime (falls back to polling when unset)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY
